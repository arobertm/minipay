@startuml MiniPay - Component Diagram
!theme plain
title MiniPay — Arhitectura Componentelor

skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 50
skinparam defaultFontSize 11
skinparam defaultFontName Arial

skinparam rectangle {
  BackgroundColor #EBF5FB
  BorderColor #2980B9
  BorderThickness 1.5
  FontColor #1B2631
  RoundCorner 8
}
skinparam database {
  BackgroundColor #FEF9E7
  BorderColor #D4AC0D
  BorderThickness 1.5
}
skinparam queue {
  BackgroundColor #FDEDEC
  BorderColor #C0392B
  BorderThickness 1.5
}
skinparam arrow {
  Color #2C3E50
  FontColor #2C3E50
  FontSize 9
}
skinparam package {
  BackgroundColor #F4F6F7
  BorderColor #95A5A6
  BorderThickness 1
  FontStyle bold
  FontColor #1B2631
}
skinparam actor {
  BackgroundColor #FDFEFE
  BorderColor #2980B9
}

' ══════════════════════════════════════
'  NIVEL 0 — ACTORI EXTERNI
' ══════════════════════════════════════

actor "Merchant\n/ Frontend" as MERCHANT
actor "Cardholder" as CARDHOLDER
actor "TPP (PSD2)" as TPP

' ══════════════════════════════════════
'  NIVEL 1 — INGRESS
' ══════════════════════════════════════

rectangle "  Traefik Ingress\n  api-minipay.online  \n  TLS / Let's Encrypt  " as TRAEFIK #D5F5E3

' ══════════════════════════════════════
'  NIVEL 2 — DOMENII SERVICII
' ══════════════════════════════════════

package "Identity Domain" as ID_PKG {
  rectangle "auth-svc\nOAuth2 · OIDC\nRS256 + Dilithium3" as AUTH #EBF5FB
  rectangle "user-svc\nArgon2id\nRBAC" as USER #EBF5FB
  rectangle "session-svc\nTTL 1h" as SESS #EBF5FB
}

package "Payments Domain" as PAY_PKG {
  rectangle "**gateway-svc  ★**\nOrchestrator\nEntry Point" as GW #D6EAF8
  rectangle "vault-svc\nAES-256-GCM\nPAN → DPAN" as VAULT #EBF5FB
  rectangle "fraud-svc\nXGBoost + SHAP\nPython / FastAPI" as FRAUD #FADBD8
  rectangle "network-svc\nISO 8583\nBIN Routing" as NET #EBF5FB
  rectangle "issuer-svc\nBank Simulator\nBalance Check" as ISS #EBF5FB
  rectangle "tds-svc\n3DS2 ACS\nOTP Challenge" as TDS #EBF5FB
  rectangle "settlement-svc\nDaily Clearing" as SETT #EBF5FB
  rectangle "psd2-svc\nOpen Banking\nAIS + PIS" as PSD2 #EBF5FB
}

package "Security Domain" as SEC_PKG {
  rectangle "audit-svc\nSHA-256\nHash Chain" as AUDIT #EBF5FB
  rectangle "notif-svc\nEmail + Push" as NOTIF #EBF5FB
}

' ══════════════════════════════════════
'  NIVEL 3 — DATE
' ══════════════════════════════════════

package "Data Layer" as DATA_PKG {
  database "MiniDS Cluster\nMicroRaft 0.7 + RocksDB 9.0\n(3 noduri: Leader + 2 Replici)" as MINIDS
  database "PostgreSQL 16\nissuer · audit · tds · settlement" as PG
  queue "Apache Kafka 3.7\ntopic: payment-events" as KAFKA
}

' ══════════════════════════════════════
'  NIVEL 4 — MONITORING
' ══════════════════════════════════════

package "Monitoring" as MON_PKG {
  rectangle "Prometheus" as PROM #F4ECF7
  rectangle "Grafana" as GRAF #F4ECF7
}

' ══════════════════════════════════════
'  CONEXIUNI — NIVEL 0 → 1 → 2
' ══════════════════════════════════════

MERCHANT -down-> TRAEFIK : HTTPS
CARDHOLDER -down-> TRAEFIK : HTTPS
TPP -down-> TRAEFIK : HTTPS

TRAEFIK -down-> GW       : /gateway/*
TRAEFIK -down-> AUTH     : /auth/*
TRAEFIK -down-> PSD2     : /psd2/*
TRAEFIK -down-> TDS      : /tds/*

' ══════════════════════════════════════
'  FLUX PLATA SINCRON (REST)
' ══════════════════════════════════════

GW -right-> VAULT  : ①tokenize PAN
GW -down->  FRAUD  : ②fraud score
GW -right-> NET    : ③authorize
GW -right-> TDS    : challenge\n(score≥0.5)
NET -right-> VAULT : detokenize
NET -right-> ISS   : ④authorize card

' ══════════════════════════════════════
'  FLUX ASYNC (KAFKA)
' ══════════════════════════════════════

GW -down[dashed]-> KAFKA    : publish event
KAFKA -right[dashed]-> AUDIT  : consume
KAFKA -right[dashed]-> NOTIF  : consume
KAFKA -right[dashed]-> SETT   : consume

' ══════════════════════════════════════
'  IDENTITY → MINIDS
' ══════════════════════════════════════

AUTH  -down-> MINIDS : ou=clients
USER  -down-> MINIDS : ou=users
SESS  -down-> MINIDS : ou=sessions
VAULT -down-> MINIDS : ou=vault

' ══════════════════════════════════════
'  SERVICII → POSTGRESQL
' ══════════════════════════════════════

ISS   -down-> PG : card accounts
AUDIT -down-> PG : audit_entries
TDS   -down-> PG : challenges
SETT  -down-> PG : batches

' ══════════════════════════════════════
'  MONITORING
' ══════════════════════════════════════

PROM -up[dashed]-> GW    : scrape
PROM -up[dashed]-> FRAUD : scrape
GRAF -right-> PROM       : query

@enduml
